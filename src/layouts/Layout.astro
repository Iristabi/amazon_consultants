---
import '../styles/global.css';
import Navigation from '../components/Navigation.jsx';
const {noindex=false,title='Amazon advertising with a clearer focus.',description='Amazon advertising, PPC campaign management and advertising audits for brands and manufacturers.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/>{noindex && <meta name="robots" content="noindex, follow"/>}<title>{title} | AMZN Consultants</title><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="wrap header-inner"><a class="wordmark" href="/" aria-label="AMZN Consultants home">amzn<span class="brand-dot">.</span><small>CONSULTANTS</small></a><Navigation client:load current={Astro.url.pathname}/></div></header><main id="main"><slot/></main><footer><div class="wrap footer-top"><a class="wordmark" href="/">amzn<span class="brand-dot">.</span><small>CONSULTANTS</small></a><p>Less complexity.<br/>More room to grow.</p><div><a href="/services/">Amazon advertising</a><a href="/about/">About us</a><a href="/blog/">Advertising insights</a><a href="/contact/">Get in touch ↗</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} AMZN Consultants</span><span>Lewes, DE, USA</span></div><div class="wrap affiliation-note">AMZN Consultants is an independent consultancy and is not affiliated with Amazon.</div></footer></body></html>
