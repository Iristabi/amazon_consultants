---
import HeroScene from '../components/HeroScene.jsx';
import Layout from '../layouts/Layout.astro';import services from '../data/services.json';
const advertising=services.filter(s=>!s.archived);
---
<Layout title="Amazon advertising" description="Amazon PPC management and advertising audits for brands and manufacturers."><section class="page-hero wrap advertising-hero"><div><p class="eyebrow">AMAZON ADVERTISING</p><h1>We manage your ads.<br/><em>You grow your business.</em></h1><p>Leave the bids, budgets and campaign checks to us. Spend your time on the business you’re building.</p><a class="button" href="/contact/">Book a free consultation ↗</a></div><HeroScene client:visible /></section><section class="wrap technology-section"><div class="technology-heading"><div><p class="eyebrow">AI + HUMAN EXPERTISE</p><h2>AI helps us spot it.<br/><em>We decide what to do.</em></h2></div><p>We use AI to help analyse campaign data and spot opportunities. Then we review what it means for your products, your budget and the decisions we make together.</p></div><div class="technology-grid"><div><span class="technology-symbol" aria-hidden="true">↗</span><h3>Bids that get attention</h3><p>AI-supported bidding helps us respond to changing campaign conditions.</p></div><div><span class="technology-symbol" aria-hidden="true">◷</span><h3>Where your ads show up</h3><p>Automation helps adjust placements. We review how those changes fit your advertising plan.</p></div><div><span class="technology-symbol" aria-hidden="true">◎</span><h3>Personal service, not a template.</h3><p>Your campaigns are managed for your business, not copied from someone else&#8217;s.</p></div></div><div class="technology-bottom"><p>You talk to us. We put the technology to work.</p><a class="text-link" href="/contact/">Talk to our team ↗</a></div></section><section class="wrap service-list">{advertising.map((s,i)=><a href={'/'+s.slug+'/'}><span class="eyebrow">0{i+1}</span><div><h2>{s.title}</h2><p>{s.copy}</p></div><span>↗</span></a>)}</section></Layout>
