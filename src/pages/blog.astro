---
import Layout from '../layouts/Layout.astro';import posts from '../data/posts.json';
const current=posts.filter(p=>!p.archived);const archived=posts.filter(p=>p.archived);
---
<Layout title="Amazon advertising insights" description="Practical guides to Amazon PPC performance, ACOS and Sponsored Products targeting."><section class="page-hero wrap"><p class="eyebrow">AMAZON ADVERTISING INSIGHTS</p><h1>Better questions.<br/><em>Clearer advertising decisions.</em></h1><p>Practical guides to understanding your campaigns, reviewing performance and choosing your next step.</p></section><section class="wrap current-articles">{current.map((p,i)=><a class="current-article" href={'/'+p.slug+'/'}><div class={'article-cover cover-'+i} aria-hidden="true">{i===0?<><span>CLICKS → ORDERS</span><b>Find the<br/>missing link.</b><i>↗</i></>:i===1?<><span>SPEND / SALES</span><b>ACOS.<br/>In context.</b><i>%</i></>:<><span>DISCOVERY + CONTROL</span><b>Two tools.<br/>One strategy.</b><i>⇄</i></>}</div><div class="archive-card-content"><p class="eyebrow">{p.category}</p><h2>{p.title}</h2><p>{p.excerpt}</p><div class="article-card-meta"><time datetime={p.date}>{p.displayDate}</time><span>{p.readTime}</span></div><span class="text-link">Read the guide ↗</span></div></a>)}</section><section class="wrap old-articles"><details><summary>Historical articles <span>2018–2019 · {archived.length} articles</span></summary><p class="archive-note">Preserved from the original website. These articles may describe outdated statistics, policies or services.</p><div class="archive-grid">{archived.map(p=><a class="archive-card" href={'/'+p.slug+'/'}><div class="archive-image"><img src={p.image} alt="" loading="lazy" width="600" height="320"/></div><div class="archive-card-content"><time datetime={p.date}>{p.displayDate}</time><h2>{p.title}</h2><p>{p.excerpt}</p><span class="text-link">Read historical article ↗</span></div></a>)}</div></details></section></Layout>
