---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
import contact from '../data/contact.json';
const whatsapp=contact.whatsappNumber.replace(/[^0-9]/g,'');
const whatsappUrl=whatsapp?'https://wa.me/'+whatsapp+'?text='+encodeURIComponent('Hi, I’d like to discuss Amazon advertising for my brand.'):null;
---
<Layout title="Book a consultation" description="Choose a consultation, WhatsApp or the enquiry form to discuss your Amazon advertising."><section class="wrap contact-quick"><div class="contact-quick-heading"><h1>Let’s talk.</h1></div><nav class="contact-methods" aria-label="Contact options"><a href="#booking">Book a consultation ↓</a></nav><div class="contact-action-grid"><div id="booking"><div class="booking-card"><div class="booking-card-title"><span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="16" rx="3"/><path d="M8 2.5v4m8-4v4M3.5 9.5h17"/><g fill="currentColor" stroke="none"><circle cx="8" cy="13.5" r="1"/><circle cx="12" cy="13.5" r="1"/><circle cx="16" cy="13.5" r="1"/><circle cx="8" cy="17" r="1"/><circle cx="12" cy="17" r="1"/><circle cx="16" cy="17" r="1"/></g></svg></span><div><p class="eyebrow">FREE INITIAL CONSULTATION</p><h2>Book a consultation</h2></div></div><div class="booking-flow" aria-label="Booking steps"><span><b>01</b> Choose a time</span><span><b>02</b> Add your details</span><span><b>03</b> You’re booked</span></div>{contact.bookingUrl?<div class="calendar-live"><a class="button" href={contact.bookingUrl} target="_blank" rel="noopener noreferrer">Choose a time ↗</a><p>Opens the booking calendar. Availability and confirmation are handled there.</p></div>:<div class="calendar-pending"><svg aria-hidden="true" viewBox="0 0 120 82" fill="none"><rect x="16" y="11" width="88" height="64" rx="10" stroke="currentColor" stroke-width="2"/><path d="M16 31h88M39 4v15M81 4v15" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><g fill="currentColor"><circle cx="38" cy="45" r="3"/><circle cx="60" cy="45" r="3"/><circle cx="82" cy="45" r="3"/><circle cx="38" cy="61" r="3"/><circle cx="60" cy="61" r="3"/></g><circle cx="82" cy="61" r="9" fill="#ff9900"/></svg><h3>The calendar is being connected.</h3><p>Live appointment times will appear once booking is set up. You can use the enquiry form while booking is being connected.</p><a class="text-link" href="#enquiry">Fill in the form →</a></div>}</div></div><div class="contact-message-column"><div id="whatsapp"><div class="whatsapp-card"><svg class="contact-icon whatsapp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.91 11.91 0 0 0 12.05 0C5.47 0 .12 5.35.12 11.93c0 2.1.55 4.15 1.59 5.96L0 24l6.28-1.65a11.9 11.9 0 0 0 5.77 1.47h.01c6.58 0 11.93-5.35 11.94-11.93a11.85 11.85 0 0 0-3.48-8.41ZM12.06 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.73.98 1-3.64-.24-.37a9.9 9.9 0 0 1-1.52-5.25c0-5.47 4.45-9.92 9.92-9.92a9.85 9.85 0 0 1 7.01 2.91 9.85 9.85 0 0 1 2.9 7.02c0 5.47-4.45 9.92-9.94 9.92Zm5.44-7.43c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.8-1.49-1.78-1.66-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.09 3.19 5.06 4.47.7.3 1.26.48 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/></svg><h3>Chat on WhatsApp</h3><p>Have a quick question? Start here.</p>{whatsappUrl?<a class="button whatsapp-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Open WhatsApp ↗</a>:<p class="connection-note">WhatsApp will be available once the business number is confirmed.</p>}</div></div><div id="enquiry"><ContactForm client:load/></div></div></div></section></Layout>