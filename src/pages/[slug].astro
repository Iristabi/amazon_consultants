---
import Layout from '../layouts/Layout.astro';import services from '../data/services.json';import posts from '../data/posts.json';
export function getStaticPaths(){return [...services.map(item=>({params:{slug:item.slug},props:{item,isPost:false}})),...posts.map(item=>({params:{slug:item.slug},props:{item,isPost:true}}))]}
const {item,isPost}=Astro.props;
---
<Layout title={item.title} description={isPost?item.excerpt:item.copy} noindex={!isPost && item.archived}><section class="page-hero wrap"><a class="eyebrow" href={isPost?'/blog/':'/services/'}>← {isPost?(item.archived?'FROM THE ARCHIVE':'ADVERTISING INSIGHTS'):item.archived?'FORMER SERVICE · ARCHIVE':'AMAZON ADVERTISING'}</a>{!isPost && item.archived && <div class="former-service-note"><strong>This service is no longer offered.</strong><p>AMZN Consultants now focuses on Amazon advertising. The information below is retained from the former website for reference.</p><a class="text-link" href="/services/">Explore current advertising services ↗</a></div>}<h1 class="article-title">{isPost?item.title:item.intro}</h1><p>{isPost?(item.archived?'An article from the original AMZN Consultants archive. Information and platform features may have changed since publication.':item.excerpt):item.copy}</p>{!isPost && !item.archived && <a class="button" href="/contact/">Book a free consultation ↗</a>}</section>{isPost && <div class="wrap article-meta"><time datetime={item.date}>{item.displayDate}</time><span>{item.archived?'Original article · Historical resource':item.readTime+' · AMZN Consultants'}</span></div>}{isPost?<article class="prose wrap" set:html={item.content}/>:<section class="wrap detail-grid">{item.items.map(([title,copy],i)=><div><p class="eyebrow">0{i+1}</p><h2>{title}</h2><p>{copy}</p></div>)}</section>}{!isPost && item.sections && <section class="wrap service-content">{item.sections.map(section=><div><h2>{section.title}</h2><div><p>{section.text}</p>{section.bullets && <ul>{section.bullets.map(point=><li>{point}</li>)}</ul>}</div></div>)}</section>}<section class="cta wrap"><p class="eyebrow">AMAZON ADVERTISING</p><h2>Let’s talk about your ads.</h2><a class="button" href="/contact/">Book a free consultation ↗</a></section></Layout>
