---
import Layout from '../layouts/Layout.astro';
import HomeVideo from '../components/HomeVideo.astro';
import Testimonials from '../components/Testimonials.jsx';
const services=[['01','Amazon PPC management','Take ads off your to-do list.','We manage your campaigns, review the numbers and make adjustments—so you don’t have to keep checking the ad console.','amazon-ppc-management'],['02','Amazon PPC audit','Not sure what’s working?','Let’s look at where your ads appear and what needs attention. Ask us about an advertising audit.','free-amazon-ppc-audit']];
---
<Layout><section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow"><span></span> FOR BRANDS &amp; MANUFACTURERS</p><h1><em>Amazon Advertising</em></h1><p class="hero-copy">You have a business to run. We take care of the bids, budgets and campaign reviews behind your Amazon ads.</p><div class="actions"><a class="button" href="/contact/">Book a free consultation <span>↗</span></a><a class="text-link" href="#services">Explore PPC management ↓</a></div></div><HomeVideo /></div></section><div class="principles"><div class="wrap"><span>Amazon PPC management</span><span>Campaign optimisation</span><span>Advertising audits</span></div></div><section id="services" class="section wrap"><div class="section-heading"><div><p class="eyebrow">WHAT WE DO</p><h2>Need someone to manage it?</h2></div><p>We can take on your campaigns or start by reviewing what you already have.</p></div><div class="service-grid">{services.map(([n,title,heading,copy,slug])=><a class="service-card" href={'/'+slug+'/'}><div class="card-top"><span>{n}</span><span>↗</span></div><p class="service-label">{title}</p><h3>{heading}</h3><p>{copy}</p><span class="card-link">Explore service →</span></a>)}</div></section><Testimonials client:visible /><section class="approach"><div class="wrap approach-grid"><div><p class="eyebrow">HOW WE WORK TOGETHER</p><h2>Tell us what’s on your plate.</h2><p>Maybe your ads take too much time. Maybe you’re spending without knowing what’s working. Tell us where you’re stuck, and we’ll talk through how we can help.</p><a class="text-link" href="/about/">Get to know AMZN Consultants ↗</a></div><div class="steps">{[['01','Tell us what’s happening','What do you sell? What are your ads doing? What would you like to change?'],['02','Work out what needs attention','We look at your products and campaigns, then discuss where to put our effort.'],['03','Agree the work before we start','You’ll know what we’re taking on, the budget we’re working with and what happens next.']].map(([n,title,copy])=><div class="step"><span>{n}</span><div><h3>{title}</h3><p>{copy}</p></div></div>)}</div></div></section><section class="section wrap founder-proof"><div class="section-heading"><div><p class="eyebrow">MEET THE TEAM</p><h2>Who you’ll work with.</h2></div><p>We’re Vito and Robert. We bring marketing experience and Amazon advertising knowledge to the work we do for your business.</p></div><div class="team-grid"><div class="team-card"><span class="team-initial" aria-hidden="true">VM</span><div><h3>Vito M.</h3><p>Co-Founder · Business Development</p></div></div><div class="team-card"><span class="team-initial" aria-hidden="true">RS</span><div><h3>Robert S.</h3><p>Co-Founder · Amazon PPC Expert</p></div></div></div><a class="text-link founder-link" href="/about/">More about the team ↗</a></section><section class="cta wrap"><p class="eyebrow">LET’S TALK</p><h2>What would you like<br/>your ads to do?</h2><a class="button" href="/contact/">Book a free consultation ↗</a><p>Tell us where you are now. We’ll take it from there.</p></section></Layout>
